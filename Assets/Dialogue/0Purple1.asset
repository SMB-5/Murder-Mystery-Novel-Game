  m_Name: 0Purple1
  m_EditorClassIdentifier: 
  lines:
  - text: Hey there, you said you recognized me earlier?
    speakerName: 'Detective:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: Yes. Although I myself didn't recognize you, but Blue did.
    speakerName: 'Purple:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: I see... So what do you do for a living?
    speakerName: 'Detective:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: I'm a security guard, currently I'm working the night shift at a family
      restaurant with these animatronics.
    speakerName: 'Purple:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: But everyone blames me for everything going on when I'm fast asleep in
      my office.
    speakerName: 'Purple:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: Anyway what about you? What do you do?
    speakerName: 'Purple:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: I'm a detective, although I retired a few years ago.
    speakerName: 'Detective:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: Ah, I see.
    speakerName: 'Purple:'
    onLineReached:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 5467562084085646670, guid: ccd911062b73cb0478555040eec8f83e, type: 3}

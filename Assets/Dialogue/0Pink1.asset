  m_Name: 0Pink1
  m_EditorClassIdentifier: 
  lines:
  - text: You like staring out the window?
    speakerName: 'Detective:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: Of course. I get to look at the shapes in the clouds, the stunning flowers
      and the beautiful lakes and oceans.
    speakerName: 'Pink:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: You must like nature then.
    speakerName: 'Detective:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: Oh yes, I used to work as a florist, but now I work at a zoo.
    speakerName: 'Pink:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: How is it at the zoo?
    speakerName: 'Detective:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: It's great! but I miss my flowers.
    speakerName: 'Pink:'
    onLineReached:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 5467562084085646670, guid: ccd911062b73cb0478555040eec8f83e, type: 3}

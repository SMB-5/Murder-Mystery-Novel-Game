  m_Name: 0Green1
  m_EditorClassIdentifier: 
  lines:
  - text: Yo yo yo, if isn't Gramps.
    speakerName: 'Green:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: That clip of you falling down has gone viral. So many people are laughing
      at you right now.
    speakerName: 'Green:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: (*Sigh* this guy gets to me.)
    speakerName: 'Detective:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: How many followers do you have?
    speakerName: 'Detective:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: Roughly 300k.
    speakerName: 'Green:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: That's a lot more than what I was expecting.
    speakerName: 'Detective:'
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - text: That's what happens when you have a camera and do some vlogging and gaming
      and doing pranks for 8 years.
    speakerName: 'Green:'
    onLineReached:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 5467562084085646670, guid: ccd911062b73cb0478555040eec8f83e, type: 3}
          m_TargetAssemblyTypeName: EventManager, Assembly-CSharp
